{
  "name": "vedic-astrology",
  "productName": "Vedic Astrology",
  "private": true,
  "version": "1.0.0",
  "description": "Vedic Astrology Desktop Application",
  "author": "Vedic Astrology",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --win --config.directories.output=\"C:/astrology-dist\"",
    "electron:dist": "npm run build && electron-builder --win nsis --config.directories.output=\"C:/astrology-dist\"",
    "electron:portable": "npm run build && electron-builder --win portable --config.directories.output=\"C:/astrology-dist\""
  },
  "build": {
    "appId": "com.vedicastrology.app",
    "productName": "Vedic Astrology",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "icon": "src/assets/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/icon.ico",
      "src/assets/logo.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vedic Astrology"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs"
}
